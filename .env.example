# ---------------------------------------------------------------------------
# Environment variables — placeholder values only. Never commit real secrets.
# Copy to .env.local for local development; set the same variables in the
# Vercel dashboard (Project → Settings → Environment Variables) for deploys.
# ---------------------------------------------------------------------------

# --- Contact form (server-side only — never exposed to the browser) --------
# API key from https://resend.com (free tier is sufficient for a portfolio).
# While unset, the contact form shows a graceful "email me directly" fallback.
RESEND_API_KEY=your_resend_api_key_here

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=contact@sedjrotovihouande.com

# Verified sender address in Resend. Until a domain is verified with Resend,
# you may use onboarding@resend.dev (the default if unset).
CONTACT_FROM_EMAIL=contact@sedjrotovihouande.com

# --- Deployment behavior ----------------------------------------------------
# Set to "true" on preview/staging deployments so search engines do not index
# nonproduction environments. Leave unset (or "false") in production.
NEXT_PUBLIC_NOINDEX=
