# ---------------------------------------------------------------------------
# Environment variables — placeholder values only. Never commit real secrets.
# Copy to .env.local for local development; set the same variables in the
# Vercel dashboard (Project → Settings → Environment Variables) for deploys.
# ---------------------------------------------------------------------------

# --- Contact form (server-side only — never exposed to the browser) --------
# API key from https://resend.com (free tier is sufficient for a portfolio).
# While unset, the contact form shows a graceful "email me directly" fallback.
RESEND_API_KEY=your_resend_api_key_here

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=contact@sedjrotovihouande.com

# Verified sender address in Resend. Until a domain is verified with Resend,
# you may use onboarding@resend.dev (the default if unset).
CONTACT_FROM_EMAIL=contact@sedjrotovihouande.com

# --- Deployment behavior ----------------------------------------------------
# Set to "true" on preview/staging deployments so search engines do not index
# nonproduction environments. Leave unset (or "false") in production.
NEXT_PUBLIC_NOINDEX=

# --- Payments (server-side only — never exposed to the browser) -------------
# Secret key from the Sedjro Digital Stripe account
# (Dashboard → Developers → API keys). Powers /api/checkout ("quick pay").
# While unset, /pay shows a graceful "email me for an invoice" fallback.
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# --- Mobile money for clients in Benin (server-side only) -------------------
# Secret API key from the Sedjro Digital FedaPay account
# (FedaPay dashboard → Paramètres → API). Powers MTN MoMo / Moov Money /
# Celtiis Cash on /pay. While unset, the Mobile Money tab shows a graceful
# "email me for instructions" fallback and no payment can be started.
FEDAPAY_SECRET_KEY=sk_sandbox_your_fedapay_secret_key_here

# "sandbox" (default, safe) or "live". Must be set to live explicitly —
# an unset/typo'd value keeps you on sandbox rather than taking real money.
FEDAPAY_ENV=sandbox
